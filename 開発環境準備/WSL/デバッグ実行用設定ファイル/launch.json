{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sample.Web (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Sample.Web/bin/Debug/net8.0/Sample.Web.dll",
      "cwd": "${workspaceFolder}/Sample.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5266"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "stopAtEntry": false
    }
  ]
}